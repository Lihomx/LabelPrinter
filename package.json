{
  "name": "labelprinter",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "cross-env ELECTRON_BUILD=true vite build",
    "electron:start": "npm run build:electron && electron .",
    "electron:pack": "npm run build:electron && electron-builder --win dir",
    "electron:dist": "npm run build:electron && electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "LabelMaster Pro - 智能标签工作站",
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.labelprinter.master",
    "productName": "LabelMasterPro",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
